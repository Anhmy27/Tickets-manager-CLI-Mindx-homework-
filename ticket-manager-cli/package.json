{
  "name": "ticket-manager-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ticket Manager CLI — built with TDD (Week 2)",
  "bin": {
    "tickets": "./dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "start": "tsx src/cli.ts",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "test:unit": "node --import tsx --test tests/unit",
    "test:integration": "node --import tsx --test tests/integration",
    "test:e2e": "node --import tsx --test tests/e2e",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "kb-api-client": "file:../kb-api-client"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2"
  }
}
